{
  "name": "soulwindow",
  "version": "0.2.1",
  "description": "SoulWindow: the WinForms-style design system shared by DynastyReader, Lyric-Sync, probable-video-editor and Project-Curator.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "css",
    "runtime",
    "solid",
    "dist",
    "vanilla",
    "README.md",
    "AGENTS.md"
  ],
  "exports": {
    "./css": "./css/index.css",
    "./css/*": "./css/*",
    "./runtime": {
      "types": "./runtime/index.d.ts",
      "default": "./runtime/index.js"
    },
    "./vite": {
      "types": "./runtime/vite.d.ts",
      "default": "./runtime/vite.js"
    },
    "./solid": {
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/source/index.js",
      "default": "./dist/esm/index.js"
    },
    "./solid/pro": {
      "types": "./dist/types/pro/index.d.ts",
      "solid": "./dist/source/pro/index.js",
      "default": "./dist/esm/pro/index.js"
    },
    "./solid/store": {
      "types": "./dist/types/store.d.ts",
      "solid": "./dist/source/store.js",
      "default": "./dist/esm/store.js"
    },
    "./vanilla": {
      "types": "./vanilla/index.d.ts",
      "default": "./vanilla/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite showcase",
    "build": "npm run clean && tsc -p tsconfig.build.json && vite build --config vite.lib.config.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "build:showcase": "vite build showcase",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test test/*.test.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "readme-images": "node scripts/readme-images.mjs"
  },
  "peerDependencies": {
    "bootstrap-icons": "^1.11.0",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "bootstrap-icons": {
      "optional": true
    }
  },
  "devDependencies": {
    "bootstrap-icons": "^1.13.1",
    "solid-js": "^1.9.17",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
